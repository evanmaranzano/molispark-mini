.login-modal__mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 9999;
}

.login-modal__sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  z-index: 10000;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.login-modal__close {
  position: absolute;
  right: 16rpx;
  top: 16rpx;
  width: 64rpx;
  height: 64rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 44rpx;
  color: #8a949e;
}

.login-modal__title {
  font-size: 34rpx;
  font-weight: 800;
  color: #17202a;
  padding: 0 48rpx;
}

.login-modal__desc {
  font-size: 24rpx;
  color: #8a949e;
  margin-top: 10rpx;
  margin-bottom: 30rpx;
}

.login-modal__agree {
  display: flex;
  align-items: flex-start;
  width: 100%;
  margin-bottom: 24rpx;
  gap: 12rpx;
}

.login-modal__check {
  width: 36rpx;
  height: 36rpx;
  margin-top: 4rpx;
  border: 2rpx solid #c5ced6;
  border-radius: 8rpx;
  box-sizing: border-box;
  color: #fff;
  font-size: 22rpx;
  line-height: 32rpx;
  text-align: center;
  flex-shrink: 0;
}

.login-modal__check--on {
  background: #2fb67d;
  border-color: #2fb67d;
}

.login-modal__agree-text {
  flex: 1;
  color: #5c6770;
  font-size: 22rpx;
  line-height: 1.6;
}

.login-modal__link {
  color: #2fb67d;
}

.login-modal__btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
  text-align: center;
  padding: 0;
}

.login-modal__btn--primary {
  background: #2fb67d;
  color: #fff;
}

.login-modal__btn--phone {
  margin-top: 20rpx;
  background: #fff;
  color: #2fb67d;
  border: 2rpx solid #2fb67d;
  box-sizing: border-box;
}

.login-modal__btn::after {
  border: none;
}

.login-modal__avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: #f1f3f5;
  margin-bottom: 24rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.login-modal__avatar::after {
  border: none;
}

.login-modal__avatar-img {
  width: 100%;
  height: 100%;
}

.login-modal__avatar-tip {
  font-size: 22rpx;
  color: #aab4be;
}

.login-modal__input {
  width: 100%;
  height: 80rpx;
  border: 1rpx solid #e2e7ea;
  border-radius: 18rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}
