<t-toast id="t-toast" />

<scroll-view class="my-page" scroll-y show-scrollbar="{{false}}">
  <status-bar compact />
  <view class="page-shell">
    <view class="topbar">
      <view class="brand">
        <view class="brand__logo">☘</view>
        <view>
          <view class="brand__name">知行社</view>
          <view class="brand__sub">个人成长与知识沉淀</view>
        </view>
      </view>
    </view>

    <view class="profile-card">
      <image wx:if="{{profile.avatarUrl}}" class="profile-card__avatar profile-card__avatar--image" src="{{profile.avatarUrl}}" mode="aspectFill" />
      <view wx:else class="profile-card__avatar">{{profile.avatarText}}</view>
      <view class="profile-card__body">
        <view class="profile-card__name-row">
          <text class="profile-card__name">{{profile.name}}</text>
          <text class="profile-card__level">{{profile.level}}</text>
          <view wx:if="{{isAuthed}}" class="profile-card__edit" bindtap="handleEditProfile">编辑资料</view>
        </view>
        <view class="profile-card__brief">{{profile.brief}}</view>
      </view>
      <view wx:if="{{isAuthed}}" class="profile-card__action profile-card__action--ghost" bindtap="handleLogout">退出</view>
      <view wx:else class="profile-card__action" bindtap="handleLogin">微信登录</view>
    </view>

    <view class="stats-card">
      <view class="stats-card__item" wx:for="{{stats}}" wx:key="label">
        <view class="stats-card__value">{{item.value}}</view>
        <view class="stats-card__label">{{item.label}}</view>
      </view>
    </view>

    <view class="menu-card">
      <view
        class="menu-row"
        wx:for="{{menuList}}"
        wx:key="title"
        data-title="{{item.title}}"
        bindtap="onMenuTap"
      >
        <view class="menu-row__icon" style="background: {{item.color}};"></view>
        <view class="menu-row__body">
          <view class="menu-row__title">{{item.title}}</view>
          <view class="menu-row__desc">{{item.desc}}</view>
        </view>
        <view class="menu-row__arrow">›</view>
      </view>
    </view>

    <view class="section-title">更多服务</view>
    <view class="menu-card">
      <view
        class="menu-row"
        wx:for="{{serviceList}}"
        wx:key="title"
        data-title="{{item.title}}"
        data-url="{{item.url}}"
        bindtap="onMenuTap"
      >
        <view class="menu-row__icon menu-row__icon--muted" style="background: {{item.color}};"></view>
        <view class="menu-row__body">
          <view class="menu-row__title">{{item.title}}</view>
          <view class="menu-row__desc">{{item.desc}}</view>
        </view>
        <view class="menu-row__arrow">›</view>
      </view>
    </view>
  </view>
</scroll-view>

<view wx:if="{{showProfileSetup}}" class="profile-setup-overlay" bindtap="closeProfileSetup">
  <view class="profile-setup-dialog" catchtap="noop">
    <view class="profile-setup-dialog__title">完善个人资料</view>
    <view class="profile-setup-dialog__subtitle">设置你的头像和昵称</view>

    <button class="profile-setup-dialog__avatar-btn" open-type="chooseAvatar" bindchooseavatar="onSetupAvatarChoose">
      <image wx:if="{{setupAvatarUrl}}" class="profile-setup-dialog__avatar-img" src="{{setupAvatarUrl}}" mode="aspectFill" />
      <view wx:else class="profile-setup-dialog__avatar-placeholder">
        <text class="profile-setup-dialog__avatar-icon">📷</text>
        <text class="profile-setup-dialog__avatar-hint">选择头像</text>
      </view>
    </button>

    <view class="profile-setup-dialog__field">
      <text class="profile-setup-dialog__label">昵称</text>
      <input
        class="profile-setup-dialog__input"
        type="nickname"
        placeholder="请输入昵称"
        value="{{setupNickname}}"
        bindinput="onSetupNicknameInput"
        maxlength="20"
      />
    </view>

    <view class="profile-setup-dialog__actions">
      <view class="profile-setup-dialog__btn profile-setup-dialog__btn--cancel" bindtap="closeProfileSetup">取消</view>
      <view class="profile-setup-dialog__btn profile-setup-dialog__btn--confirm {{setupSubmitting || !setupNickname ? 'profile-setup-dialog__btn--disabled' : ''}}" bindtap="submitProfileSetup">
        {{setupSubmitting ? '保存中...' : '完成'}}
      </view>
    </view>
  </view>
</view>
