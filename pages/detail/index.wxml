<scroll-view class="detail-page" scroll-y show-scrollbar="{{false}}">
  <status-bar compact />
  <view class="page-shell" wx:if="{{post}}">
    <view class="topbar">
      <view class="back" bindtap="navigateBack">‹</view>
      <view class="topbar__title">内容详情</view>
      <view class="topbar__action">•••</view>
    </view>

    <view class="article-card">
      <view class="article-meta">
        <view class="avatar">{{post.authorInitial}}</view>
        <view class="article-meta__body">
          <view class="article-meta__name">{{post.author}}</view>
          <view class="article-meta__info">{{post.category}} · {{post.timeText || post.time}}</view>
        </view>
      </view>

      <view class="article-title">{{post.title}}</view>

      <view wx:if="{{post.images && post.images.length}}" class="article-images">
        <image wx:for="{{post.images}}" wx:key="*this" class="article-images__item" src="{{item}}" mode="widthFix" />
      </view>

      <view class="article-content">
        <view class="article-content__paragraph" wx:for="{{post.content}}" wx:key="*this">{{item}}</view>
      </view>

      <view wx:if="{{isAdmin}}" class="admin-bar">
        <view class="admin-bar__btn {{post.featured ? 'admin-bar__btn--active' : ''}}" bindtap="toggleFeature">{{post.featured ? '★ 已加精（点击取消）' : '☆ 加精到精选页'}}</view>
      </view>

      <view class="article-stats">
        <text>{{post.views || 0}} 阅读</text>
        <text>{{post.likes || 0}} 点赞</text>
        <text>{{post.commentCount || 0}} 评论</text>
      </view>

      <view class="sticky-actions">
        <view
          class="sticky-actions__item {{(item.key === 'like' && liked) || (item.key === 'collect' && collected) ? 'sticky-actions__item--active' : ''}}"
          wx:for="{{actionList}}"
          wx:key="key"
          data-key="{{item.key}}"
          bindtap="handleAction"
        >
          <text class="sticky-actions__icon">{{item.icon}}</text>
          <text>{{liked && item.key === 'like' ? '已赞' : (collected && item.key === 'collect' ? '已藏' : item.label)}}</text>
        </view>
      </view>
    </view>

    <view class="comment-section">
      <view class="section-title">评论区（{{comments.length}}）</view>
      <view wx:if="{{!comments.length}}" class="empty-hint">暂无评论，快来抢沙发吧</view>
      <view class="comment" wx:for="{{comments}}" wx:key="_id">
        <view class="comment__avatar">{{item.nameInitial}}</view>
        <view class="comment__body">
          <view class="comment__head">
            {{item.name}}
            <text class="comment__time">{{item.timeText || item.time}}</text>
          </view>
          <view class="comment__text">{{item.body}}</view>
          <view class="reply" wx:if="{{item.reply}}">作者回复：{{item.reply}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="load-error" wx:if="{{loadError && !post}}">
    <view class="load-error__hint">加载失败</view>
    <view class="load-error__retry" bindtap="retryLoad">重试</view>
  </view>
</scroll-view>

<view class="comment-input-bar" wx:if="{{showCommentInput}}">
  <input
    class="comment-input-bar__field"
    placeholder="写评论..."
    value="{{commentText}}"
    maxlength="500"
    bindinput="onCommentInput"
    confirm-type="send"
    bindconfirm="submitComment"
    focus="{{showCommentInput}}"
  />
  <view class="comment-input-bar__btn" bindtap="submitComment">发送</view>
</view>
