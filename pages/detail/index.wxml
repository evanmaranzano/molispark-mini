<scroll-view class="detail-page" scroll-y show-scrollbar="{{false}}">
  <view class="page-shell" wx:if="{{post}}">
    <view class="topbar">
      <view class="back" bindtap="navigateBack">‹</view>
      <view class="topbar__title">内容详情</view>
      <view class="topbar__action">•••</view>
    </view>

    <view class="article-card">
      <view class="article-meta">
        <view class="avatar">{{post.author.slice(0, 1)}}</view>
        <view class="article-meta__body">
          <view class="article-meta__name">{{post.author}}</view>
          <view class="article-meta__info">{{post.category}} · {{post.time}}</view>
        </view>
      </view>

      <view class="article-title">{{post.title}}</view>

      <view class="hero hero--{{post.coverStyle}}">
        <view class="hero__label">{{post.heroTitle}}</view>
      </view>

      <view class="article-content">
        <view class="article-content__paragraph" wx:for="{{post.content}}" wx:key="*this">{{item}}</view>
      </view>

      <view class="sticky-actions">
        <view
          class="sticky-actions__item"
          wx:for="{{actionList}}"
          wx:key="key"
          data-label="{{item.label}}"
          bindtap="handleAction"
        >
          {{item.label}}
        </view>
      </view>
    </view>

    <view class="comment-section">
      <view class="section-title">评论区</view>
      <view class="comment" wx:for="{{comments}}" wx:key="name">
        <view class="comment__avatar">{{item.name.slice(0, 1)}}</view>
        <view class="comment__body">
          <view class="comment__head">
            {{item.name}}
            <text class="comment__time">{{item.time}}</text>
          </view>
          <view class="comment__text">{{item.body}}</view>
          <view class="reply" wx:if="{{item.reply}}">{{item.reply}}</view>
        </view>
      </view>
    </view>
  </view>
</scroll-view>
