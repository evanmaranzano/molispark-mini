<scroll-view class="release-page" scroll-y show-scrollbar="{{false}}">
  <status-bar compact />
  <view class="page-shell">
    <view class="topbar">
      <view class="brand">
        <view class="brand__logo">☘</view>
        <view>
          <view class="brand__name">知行社</view>
          <view class="brand__sub">分享观点与见解</view>
        </view>
      </view>
    </view>

    <view class="release-hero">
      <view class="release-hero__title">发布</view>
      <view class="release-hero__desc">分享你的想法、经验与观察</view>
    </view>

    <view class="option-list">
      <view
        class="option-card"
        wx:for="{{publishOptions}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="handleOptionTap"
      >
        <view class="option-card__icon" style="background: {{item.color}};">{{item.icon}}</view>
        <view class="option-card__body">
          <view class="option-card__title">{{item.title}}</view>
          <view class="option-card__desc">{{item.desc}}</view>
        </view>
        <view wx:if="{{item.id === 'draft' && draftCount > 0}}" class="option-card__badge">{{draftCount}}</view>
        <view class="option-card__arrow">›</view>
      </view>
    </view>

    <view class="notice-card">
      <view class="notice-card__title">发布须知</view>
      <view class="notice-card__line">请发布积极、真实、原创的内容</view>
      <view class="notice-card__line">尊重他人，文明交流，禁止恶意攻击</view>
      <view class="notice-card__line">遵守相关法律法规，不发布违规内容</view>
    </view>
  </view>
</scroll-view>
<login-modal show="{{showLoginModal}}" bind:logined="onLogined" />
