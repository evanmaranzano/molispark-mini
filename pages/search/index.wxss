.search-page {
  height: 100vh;
  background: #f5f7f8;
}

.search-shell {
  padding: calc(24rpx + env(safe-area-inset-top)) 24rpx 40rpx;
}

.search-head {
  display: grid;
  grid-template-columns: 52rpx 1fr 76rpx;
  gap: 10rpx;
  align-items: center;
  margin-bottom: 28rpx;
}

.search-head__back {
  color: #17202a;
  font-size: 46rpx;
  text-align: center;
}

.search-head__action {
  color: #2fb67d;
  font-size: 24rpx;
  font-weight: 800;
  text-align: center;
}

.search-input {
  display: flex;
  align-items: center;
  gap: 10rpx;
  height: 72rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #f0f2f4;
  color: #7d8790;
}

.search-input__field {
  flex: 1;
  min-width: 0;
  color: #17202a;
  font-size: 24rpx;
}

.search-input__clear {
  font-size: 20rpx;
}

.section-title {
  color: #17202a;
  font-size: 30rpx;
  font-weight: 800;
}

.keyword-scroll {
  margin: 18rpx 0 24rpx;
  white-space: nowrap;
}

.keyword-scroll__inner {
  display: inline-flex;
  gap: 12rpx;
}

.keyword {
  padding: 16rpx 24rpx;
  border-radius: 999rpx;
  background: #f0f2f4;
  color: #6d7781;
  font-size: 22rpx;
}

.keyword--active {
  background: #2fb67d;
  color: #fff;
  font-weight: 700;
}

.result-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 20rpx 4rpx 16rpx;
  color: #7d8790;
  font-size: 22rpx;
}

.post-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.post-card {
  display: flex;
  gap: 18rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 10rpx 30rpx rgba(31, 45, 61, 0.08);
}

.post-card__body {
  flex: 1;
  min-width: 0;
}

.post-card__title {
  color: #17202a;
  font-size: 28rpx;
  line-height: 1.35;
  font-weight: 800;
}

.post-card__desc {
  margin-top: 10rpx;
  color: #6f7c86;
  font-size: 22rpx;
  line-height: 1.55;
}

.post-card__meta {
  margin-top: 14rpx;
  color: #8a949e;
  font-size: 20rpx;
}

.post-card__cover {
  width: 128rpx;
  height: 128rpx;
  flex-shrink: 0;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #e7eadf, #b8d5c0);
}

.post-card__cover--ai {
  background: linear-gradient(135deg, #e7f3ee, #b8d5c5);
}

.post-card__cover--note {
  background: linear-gradient(135deg, #f3eadc, #d8bea0);
}
