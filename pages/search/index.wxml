<scroll-view class="search-page" scroll-y show-scrollbar="{{false}}">
  <view class="search-shell">
    <view class="search-head">
      <view class="search-head__back" bindtap="goBack">‹</view>
      <view class="search-input">
        <text>🔍</text>
        <input
          class="search-input__field"
          placeholder="搜索帖子、专区或内容"
          value="{{activeSearch}}"
          bindinput="handleInput"
          confirm-type="search"
          bindconfirm="doSearch"
        />
        <view class="search-input__clear" bindtap="clearSearch">✕</view>
      </view>
      <view class="search-head__action" bindtap="doSearch">搜索</view>
    </view>

    <view class="section-title">热门搜索</view>
    <scroll-view class="keyword-scroll" scroll-x show-scrollbar="{{false}}">
      <view class="keyword-scroll__inner">
        <view
          class="{{item.className}}"
          wx:for="{{hotKeywords}}"
          wx:key="value"
          data-keyword="{{item.value}}"
          bindtap="applyKeyword"
        >
          {{item.label}}
        </view>
      </view>
    </scroll-view>

    <view class="result-head">
      <text>{{resultText}}</text>
      <text>最新⌄</text>
    </view>

    <view class="post-list">
      <view class="post-card" wx:for="{{posts}}" wx:key="id" data-id="{{item._id || item.id}}" bindtap="goDetail">
        <view class="post-card__body">
          <view class="post-card__title">{{item.title}}</view>
          <view class="post-card__desc">{{item.desc}}</view>
          <view class="post-card__meta">{{item.author}} · {{item.time}}</view>
        </view>
        <view class="post-card__cover post-card__cover--{{item.coverStyle}}"></view>
      </view>
    </view>
  </view>
</scroll-view>
