<scroll-view class="sub-page" scroll-y show-scrollbar="{{false}}">
  <status-bar compact />
  <view class="sub-shell">
    <view class="sub-topbar">
      <view class="sub-topbar__back" bindtap="navigateBack">‹</view>
      <view class="sub-topbar__title">设置</view>
    </view>

    <view class="menu-card">
      <view class="menu-row" bindtap="clearCache">
        <view class="menu-row__icon"></view>
        <view class="menu-row__body">
          <view class="menu-row__title">清除本地缓存</view>
        </view>
        <view class="menu-row__arrow">›</view>
      </view>
      <view class="menu-row" bindtap="goPrivacy">
        <view class="menu-row__icon"></view>
        <view class="menu-row__body">
          <view class="menu-row__title">隐私政策</view>
        </view>
        <view class="menu-row__arrow">›</view>
      </view>
      <view class="menu-row" bindtap="showAbout">
        <view class="menu-row__icon"></view>
        <view class="menu-row__body">
          <view class="menu-row__title">关于摩力创境</view>
        </view>
        <view class="menu-row__arrow">›</view>
      </view>
    </view>
  </view>
</scroll-view>
