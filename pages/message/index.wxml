<scroll-view class="message-scroll" scroll-y show-scrollbar="{{false}}">
  <status-bar compact />
  <view class="message-hero">
    <view class="message-hero__eyebrow">Inbox Center</view>
    <view class="message-hero__title">消息</view>
    <view class="message-hero__desc">把论坛回复、星球通知和私信会话收进一个可快速处理的消息面板。</view>

    <view class="message-hero__stats">
      <view class="message-hero__stat" wx:for="{{summaryCards}}" wx:key="label">
        <view class="message-hero__value">{{item.value}}</view>
        <view class="message-hero__label">{{item.label}}</view>
      </view>
    </view>
  </view>

  <view class="message-section">
    <view class="message-section__head">
      <view class="message-section__title">优先处理</view>
      <view class="message-section__hint">{{messageList.length}} 个会话</view>
    </view>

    <view wx:if="{{loadError}}" class="empty-hint">消息暂时无法加载</view>
    <view wx:elif="{{!messageList.length && !loading}}" class="empty-hint">暂无消息</view>
    <view class="message-list">
      <view wx:for="{{messageList}}" wx:key="_id" class="message-card" bindtap="goDetail" data-id="{{item.postId}}" data-msg-id="{{item._id || item.id}}">
        <view class="message-card__avatar">{{item.avatarText}}</view>
        <view class="message-card__body">
          <view class="message-card__top">
            <view class="message-card__name">{{item.fromName || item.name}}</view>
            <view class="message-card__time">{{item.time || item.createdAt}}</view>
          </view>
          <view class="message-card__preview">{{item.preview}}</view>
          <view class="message-card__meta">
            <view class="message-card__tag">{{item.scene}}</view>
            <view class="message-card__status">{{item.statusText}}</view>
          </view>
        </view>
        <view wx:if="{{item.showBadge}}" class="message-card__badge">新</view>
      </view>
    </view>
  </view>
</scroll-view>
<login-modal show="{{showLoginModal}}" bind:logined="onLogined" />
