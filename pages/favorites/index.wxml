<scroll-view class="sub-page" scroll-y show-scrollbar="{{false}}">
  <status-bar compact />
  <view class="sub-shell">
    <view class="sub-topbar">
      <view class="sub-topbar__back" bindtap="navigateBack">‹</view>
      <view class="sub-topbar__title">我的收藏</view>
    </view>

    <view wx:if="{{!posts.length && !loading}}" class="empty-hint">暂无收藏</view>
    <view class="post-list">
      <view class="post-card" wx:for="{{posts}}" wx:key="_id" data-id="{{item._id || item.id}}" bindtap="goDetail">
        <view class="post-card__body">
          <view class="post-card__title">{{item.title}}</view>
          <view class="post-card__desc">{{item.desc}}</view>
          <view class="post-card__meta">{{item.author}} · {{item.time || item.updatedAt}}</view>
        </view>
        <view class="post-card__cover post-card__cover--{{item.coverStyle}}"></view>
      </view>
    </view>
  </view>
</scroll-view>
