<scroll-view
  class="home-page"
  scroll-y
  enhanced
  show-scrollbar="{{false}}"
  refresher-enabled
  refresher-triggered="{{enable}}"
  bindrefresherrefresh="onRefresh"
>
  <status-bar />
  <view class="page-shell">
    <view class="topbar">
      <view class="brand">
        <view class="brand__logo">☘</view>
        <view>
          <view class="brand__name">知行社</view>
          <view class="brand__sub">连接知识 · 启发成长</view>
        </view>
      </view>
    </view>

    <view class="search-box" bindtap="goSearch">🔍 <text>搜索帖子、精选或内容</text></view>

    <swiper class="hero-swiper" autoplay circular interval="4500" duration="400" indicator-dots indicator-color="rgba(24,47,35,.15)" indicator-active-color="#286247">
      <swiper-item>
        <view class="hero-card">
          <view class="hero-card__content">
            <view class="hero-card__title">深度思考，<text>
</text>共同成长</view>
            <view class="hero-card__desc">与优秀的人一起，探索知识的边界</view>
            <view class="hero-card__button" bindtap="goZones">了解精选</view>
          </view>
        </view>
      </swiper-item>
      <swiper-item bindtap="goSalon">
        <view class="hero-slide">
          <image class="hero-slide__poster" src="{{salonPoster}}" mode="aspectFill" />
          <view class="hero-slide__tag">活动报名中 · 点击查看</view>
        </view>
      </swiper-item>
      <swiper-item bindtap="goActivities">
        <view class="hero-card">
          <view class="hero-card__content">
            <view class="hero-card__title">近期活动</view>
            <view class="hero-card__desc">沙龙、共读会、打卡营，报名从速</view>
            <view class="hero-card__button">全部活动</view>
          </view>
        </view>
      </swiper-item>
    </swiper>

    <view class="feature-panel">
      <view
        class="feature-item"
        wx:for="{{quickActions}}"
        wx:key="key"
        data-path="{{item.path}}"
        bindtap="handleFeatureTap"
      >
        <view class="feature-item__icon feature-item__icon--{{item.icon}}" style="background: {{item.color}};">
          <text wx:if="{{item.icon === 'chat'}}">💬</text>
          <text wx:elif="{{item.icon === 'diamond'}}">◆</text>
          <text wx:else>★</text>
        </view>
        <view class="feature-item__title">{{item.title}}</view>
        <view class="feature-item__desc">{{item.desc}}</view>
      </view>
    </view>

    <view class="section-head">
      <view class="section-head__title">推荐内容</view>
      <view class="section-head__more" bindtap="goZones">更多 ›</view>
    </view>

    <view wx:if="{{loadError}}" class="empty-hint">推荐内容暂时无法加载</view>
    <view class="post-list" wx:else>
      <view class="post-card" wx:for="{{recommendList}}" wx:key="id" bindtap="handlePostTap" data-id="{{item._id || item.id}}">
        <view class="post-card__body">
          <view class="post-card__title">{{item.title}}</view>
          <view class="post-card__desc">{{item.desc}}</view>
          <view class="post-card__meta">
            <view class="post-card__avatar">{{item.authorInitial}}</view>
            <text>{{item.author}}</text>
            <text>·</text>
            <text>{{item.timeText || item.time}}</text>
          </view>
        </view>
        <view class="post-card__cover post-card__cover--{{item.coverStyle}}">
          <view class="post-card__cover-title">{{item.heroTitle || item.title}}</view>
        </view>
      </view>
    </view>
  </view>
</scroll-view>
<t-message id="t-message" />
<login-modal show="{{showLoginModal}}" bind:logined="onLogined" />
